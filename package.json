{
  "name": "chromonym",
  "description": "Find the nearest named color for any hex, RGB, HSL, or HSV value. One color-naming API for any palette: identify, resolve, and convert color names across your own palette or twenty-seven built-in sets (CSS, X11, Pantone, Copic, Crayola, Farrow & Ball, NTC, XKCD, Japanese traditional colors, RAL, Tailwind, Material, USWDS, Resene, NCS, ISCC-NBS, NBS, FS 595 B/C, CARC, TCCA, MIL-STD-101C, MIL-STD-709D, MIL-STD-2525D, US military identity colors, Werner, Pokemon); fully typed, tree-shakeable, perceptual color distance (CIEDE2000 / OKLAB).",
  "keywords": [
    "color",
    "colors",
    "colour",
    "color-name",
    "color-names",
    "color-naming",
    "named-colors",
    "nearest-color",
    "closest-color",
    "color-convert",
    "css-colors",
    "x11-colors",
    "pantone",
    "copic",
    "crayola",
    "farrow-ball",
    "ral",
    "tailwind",
    "material-design",
    "deltaE",
    "ciede2000",
    "oklab",
    "perceptual",
    "typescript",
    "tree-shakeable",
    "hex",
    "rgb",
    "hsl",
    "hsv",
    "palette"
  ],
  "author": "the-simian <info@simiancraft.com>",
  "license": "MIT",
